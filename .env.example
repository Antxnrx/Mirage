# Light-wallet server (lightwalletd gRPC)
LWD_HOST=testnet.zec.rocks:443
# zkool_graphql wallet server (keep it on localhost)
ZKOOL_URL=http://127.0.0.1:8000/graphql
ZKOOL_ACCOUNT_ID=1
# Mirage API
PORT=8787
HOST=127.0.0.1
# Blocks to backfill on first run (~25 s per block on NU7 testnet)
INDEX_BACKFILL_BLOCKS=40000
INDEX_POLL_SECS=30
DATA_DIR=./data
# zkool account ids Mirage may use (first is default)
ZKOOL_ACCOUNTS=1,2
# Testnet safety caps for spending requests
MAX_PER_REQUEST_ZEC=0.1
SENDS_PER_HOUR=30
# 1 = real exit schedule (hours apart); 0.01 = demo speed (minutes apart)
EXIT_DELAY_SCALE=1
JOB_POLL_SECS=20
